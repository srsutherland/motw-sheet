{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playbook.schema.json",
  "title": "Playbook",
  "$comment": "PRELIMINARY. Describes the format as the app uses it today; it isn't a spec to design against, and it changes whenever development needs it. Background and decisions: docs/Schema Notes.md.",
  "type": "object",
  "properties": {
    "$schema": { "description": "JSON Schema URI", "type": "string" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "updated": { "description": "Date last changed", "$ref": "common.schema.json#/$defs/dateString" },
    "id": {
      "description": "File id, the first segment of absolute references (`@the_expert.haven`)",
      "type": "string",
      "pattern": "^the_[a-z0-9_]+$"
    },
    "type": { "description": "Object type hint", "const": "playbook" },
    "name": { "description": "Display name, including \"The\" (`The Spell-Slinger`)", "type": "string" },
    "emoji": { "description": "Emoji icon (`🔮`)", "type": "string" },
    "quote": { "description": "Flavor text at the top of the playbook", "$ref": "common.schema.json#/$defs/markdown" },
    "luck": {
      "description": "Luck track",
      "type": "object",
      "properties": {
        "max": { "description": "Number of boxes", "type": "integer", "minimum": 1 },
        "special": { "description": "Playbook's consequences for spending luck", "$ref": "common.schema.json#/$defs/markdown" }
      },
      "required": ["max", "special"],
      "additionalProperties": false
    },
    "harm": {
      "description": "Harm track",
      "type": "object",
      "properties": {
        "max": { "description": "Number of boxes", "type": "integer", "minimum": 1 },
        "unstable": { "description": "Harm at which wounds become unstable.", "type": "integer", "minimum": 1 }
      },
      "required": ["max", "unstable"],
      "additionalProperties": false
    },
    "pre_moves": {
      "description": "Features shown before the moves (Combat Magic, Monster Breed).",
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    },
    "moves": { "$ref": "#/$defs/moveList" },
    "post_moves": {
      "description": "Features shown after the moves (Haven).",
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    },
    "starting_gear": { "$ref": "#/$defs/gearList" },
    "getting_started": { "$ref": "#/$defs/gettingStarted" },
    "look": { "$ref": "#/$defs/look" },
    "ratings_base": {
      "description": "Initial ratings arrays",
      "type": "object",
      "properties": {
        "heading": { "description": "Heading text displayed before the options", "type": "string" },
        "options": { "description": "List of options to choose from", "type": "array", "items": { "$ref": "common.schema.json#/$defs/ratings" }, "minItems": 1 }
      },
      "required": ["options"],
      "additionalProperties": false
    },
    "introductions": { "description": "Introductions section", "$ref": "#/$defs/text" },
    "history": {
      "description": "Relationship options for the other hunters (plain text, freely edited once picked)",
      "type": "object",
      "properties": {
        "description": { "$ref": "common.schema.json#/$defs/paragraphs" },
        "options": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/plainText" } }
      },
      "required": ["options"],
      "additionalProperties": false
    },
    "improvements": { "$ref": "#/$defs/improvements" }
  },
  "required": [
    "schema_version", "updated", "id", "type", "name", "luck", "harm", "moves",
    "starting_gear", "getting_started", "look", "ratings_base", "history", "improvements"
  ],
  "additionalProperties": false,

  "$defs": {
    "text": {
      "type": "object",
      "properties": { "description": { "$ref": "common.schema.json#/$defs/paragraphs" } },
      "required": ["description"],
      "additionalProperties": false
    },
    "option": {
      "description": "An entry in `options`: a reference (`@basic_moves.use_magic.heal`, `@textbox`), a plain string (stored as written), or an object.",
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/reference" },
        { "$ref": "common.schema.json#/$defs/plainText" },
        { "$ref": "#/$defs/node" }
      ]
    },
    "node": {
      "description": "A playbook object. Needs an `id`, or a `name` to make one from (choices are stored by path).\n- Untyped, with `options` and no `choose`: a sub-list (Combat Magic's bases), offered grouped with the container's options\n- With its own `choose`: an option with its own choice (Pure Drive's emotion)",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "description": "Object type hint", "enum": ["move", "gear", "feature"] },
        "name": { "description": "Display name", "type": "string" },
        "description": { "description": "The display text from the playbook", "$ref": "common.schema.json#/$defs/paragraphs" },
        "heading": { "description": "Heading text displayed before the options", "$ref": "common.schema.json#/$defs/markdown" },
        "tags": { "$ref": "common.schema.json#/$defs/tags" },
        "options": { "description": "List of options to choose from", "type": "array", "items": { "$ref": "#/$defs/option" } },
        "choose": { "$ref": "common.schema.json#/$defs/choose" },
        "effects": { "description": "Effects when gained", "type": "array", "items": { "$ref": "common.schema.json#/$defs/effect" } },
        "details": { "$ref": "common.schema.json#/$defs/details" },
        "on_edit": { "$ref": "common.schema.json#/$defs/pageOverride" },
        "on_view": { "$ref": "common.schema.json#/$defs/pageOverride" }
      },
      "additionalProperties": false,
      "if": { "not": { "required": ["name"] } },
      "then": { "required": ["id"] }
    },
    "feature": {
      "description": "A playbook-specific section that isn't a move (Combat Magic, Haven, Curse).",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/node" }],
      "properties": { "type": { "const": "feature" } },
      "required": ["type", "name"]
    },
    "move": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/node" }],
      "properties": { "type": { "const": "move" } },
      "required": ["type", "name", "description"]
    },
    "gear": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/node" }],
      "properties": { "type": { "const": "gear" } },
      "required": ["type", "name", "tags"]
    },
    "moveList": {
      "description": "Playbook moves",
      "type": "object",
      "properties": {
        "id": { "description": "Reference id", "const": "moves" },
        "description": { "description": "The display text from the playbook", "$ref": "common.schema.json#/$defs/paragraphs" },
        "options": { "description": "List of options to choose from", "type": "array", "items": { "$ref": "#/$defs/move" } }
      },
      "required": ["id", "options"],
      "additionalProperties": false
    },
    "gearList": {
      "description": "Starting gear options",
      "type": "object",
      "properties": {
        "id": { "description": "Reference id", "const": "starting_gear" },
        "description": { "description": "The display text from the playbook", "$ref": "common.schema.json#/$defs/paragraphs" },
        "heading": { "description": "Heading text displayed before the options", "$ref": "common.schema.json#/$defs/markdown" },
        "options": { "description": "List of options to choose from", "type": "array", "items": { "$ref": "#/$defs/gear" } }
      },
      "required": ["id", "options"],
      "additionalProperties": false
    },
    "gettingStarted": {
      "description": "Character creation: what you're granted and the choices you make, in the same shape as an improvement.",
      "type": "object",
      "properties": {
        "description": { "description": "The display text from the playbook", "$ref": "common.schema.json#/$defs/paragraphs" },
        "grant": { "$ref": "common.schema.json#/$defs/grant" },
        "choose": { "$ref": "common.schema.json#/$defs/choose" }
      },
      "additionalProperties": false
    },
    "look": {
      "description": "Look traits (clothes, eyes, aura...)",
      "type": "object",
      "properties": {
        "id": { "description": "Reference id", "const": "look" },
        "heading": { "description": "Heading text displayed before the options", "type": "string" },
        "options": {
          "description": "List of traits, one pick from each",
          "type": "array",
          "items": { "$ref": "#/$defs/lookTrait" }
        }
      },
      "required": ["id", "options"],
      "additionalProperties": false
    },
    "lookTrait": {
      "description": "Look trait: display format and options",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "format": {
          "description": "How the pick reads on the sheet: `___` stands for it (\"___ clothes\").",
          "type": "string",
          "pattern": "___"
        },
        "options": {
          "description": "List of options to choose from",
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/plainText" },
              { "$ref": "common.schema.json#/$defs/ref_textbox" }
            ]
          }
        }
      },
      "required": ["id", "format", "options"],
      "additionalProperties": false
    },
    "improvements": {
      "description": "Leveling up: the improvement lists",
      "type": "object",
      "properties": {
        "id": { "description": "Reference id", "const": "improvements" },
        "description": { "description": "The display text from the playbook", "$ref": "common.schema.json#/$defs/paragraphs" },
        "options": {
          "description": "Improvement lists: basic, advanced, and mythic (homebrew: not on the paper playbook)",
          "type": "array",
          "items": { "$ref": "#/$defs/improvementList" }
        }
      },
      "required": ["id", "options"],
      "additionalProperties": false
    },
    "improvementList": {
      "description": "Improvement list",
      "type": "object",
      "properties": {
        "id": { "description": "Reference id", "enum": ["basic", "advanced", "mythic"] },
        "name": { "description": "Display name", "type": "string" },
        "description": { "description": "The display text from the playbook", "$ref": "common.schema.json#/$defs/paragraphs" },
        "requires": {
          "description": "Unlock conditions",
          "type": "object",
          "properties": {
            "level": { "description": "Level ups completed before the one being spent", "type": "integer", "minimum": 0 },
            "improvements": { "description": "Improvements taken", "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "cost": {
          "description": "Cost of each, in unspent improvements",
          "type": "integer",
          "minimum": 1
        },
        "options": { "description": "List of options to choose from", "type": "array", "items": { "$ref": "#/$defs/improvement" } }
      },
      "required": ["id", "name", "options"],
      "additionalProperties": false
    },
    "improvement": {
      "description": "An improvement option (ids explicit and unique across all improvement lists; mythic ones prefixed `mythic_`)",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "description": "Object type hint", "const": "improvement" },
        "description": { "description": "The display text from the playbook", "$ref": "common.schema.json#/$defs/markdown" },
        "grant": { "$ref": "common.schema.json#/$defs/grant" },
        "choose": { "$ref": "common.schema.json#/$defs/choose" },
        "effects": { "description": "Effects when gained", "type": "array", "items": { "$ref": "common.schema.json#/$defs/effect" } },
        "special": { "description": "Kind of special improvement effect", "enum": ["change_playbook", "second_hunter", "retire", "turn_evil"] },
        "cost": { "description": "Cost in unspent improvements (default: the list's `cost`, or 1)", "type": "integer", "minimum": 1 },
        "options": {
          "description": "List of options to choose from (\"+1 to any rating\": one per rating)",
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        }
      },
      "required": ["id", "type", "description"],
      "additionalProperties": false
    }
  }
}
