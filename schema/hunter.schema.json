{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hunter.schema.json",
  "title": "Hunter",
  "$comment": "PRELIMINARY. Describes the format as the app uses it today; it isn't a spec to design against, and it changes whenever development needs it. Background and decisions: docs/Schema Notes.md.",
  "description": "Choices and plain values; ratings, moves, gear and features follow from replaying getting_started, then each improvement in the order taken.",
  "type": "object",
  "properties": {
    "$schema": { "description": "JSON Schema URI", "type": "string" },
    "schema_version": { "description": "Hunter format version (date of the last breaking change)", "const": "0.1.2026.11.25" },
    "uid": { "description": "Unique id", "type": "string", "minLength": 1 },
    "created": { "description": "Creation timestamp", "$ref": "#/$defs/timestamp" },
    "updated": { "description": "When last saved.", "$ref": "#/$defs/timestamp" },
    "playbook_name": { "description": "Playbook display name (`The Spell-Slinger`)", "type": "string" },
    "playbook_updated": {
      "description": "The playbook's `updated` date when this hunter was made.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/dateString" }, { "const": "" }]
    },
    "name": { "description": "Hunter name", "type": "string" },
    "pronouns": { "description": "Pronouns", "type": "string" },
    "look": {
      "description": "Look trait id -> the pick, or what was written in.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
      "additionalProperties": { "type": "string" }
    },
    "ratings_base": {
      "description": "A copy of the chosen ratings line.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/ratings" }, { "type": "null" }]
    },
    "history": {
      "description": "Relationships with the other hunters",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "description": "Other hunter's name", "type": "string" },
          "option": { "description": "Relationship: a playbook option, freely edited", "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "getting_started": {
      "description": "Choices for the playbook's getting_started: an entry per grant, and the choices for the choose rule(s)",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/choices" }],
      "properties": {
        "grant": { "type": "array", "items": { "$ref": "#/$defs/refWithChoices" } }
      },
      "required": ["grant"],
      "unevaluatedProperties": false
    },
    "improvements": {
      "description": "In the order taken.",
      "type": "array",
      "items": { "$ref": "#/$defs/refWithChoices" }
    },
    "extra_gear": {
      "description": "Gear added during play.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "tags": { "$ref": "common.schema.json#/$defs/tags" }
        },
        "required": ["name", "tags"],
        "additionalProperties": false
      }
    },
    "harm": { "description": "Harm marked", "type": "integer", "minimum": 0 },
    "unstable": { "description": "Unstable wounds", "type": "boolean" },
    "luck_used": { "description": "Luck spent", "type": "integer", "minimum": 0 },
    "experience": { "description": "Experience marked (out of 5)", "type": "integer", "minimum": 0 },
    "level": { "description": "Total level, including unspent improvements", "type": "integer", "minimum": 0 },
    "computed": { "$ref": "#/$defs/computed" },
    "playbook": {
      "description": "A reference to (`@the_spellslinger`), or copy of, the hunter's playbook",
      "anyOf": [
        { "type": "string", "pattern": "^@the_[a-z0-9_]+$" },
        { "$ref": "playbook.schema.json" }
      ]
    }
  },
  "required": [
    "schema_version", "uid", "created", "playbook_name", "name", "look", "ratings_base",
    "history", "getting_started", "improvements", "extra_gear", "harm", "unstable",
    "luck_used", "experience", "level", "playbook"
  ],
  "additionalProperties": false,

  "$defs": {
    "timestamp": {
      "description": "ISO 8601 timestamp",
      "type": "string",
      "format": "date-time"
    },
    "choices": {
      "description": "The hunter's side of an object's choose rule(s). One rule: `chosen` directly. Several: `choose`, mirroring the playbook (the nth rule with a given `from` goes with the nth entry with that `from`). No rules: neither.",
      "type": "object",
      "properties": {
        "chosen": { "type": "array", "items": { "$ref": "#/$defs/choice" } },
        "choose": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "$ref": "common.schema.json#/$defs/reference" },
              "chosen": { "type": "array", "items": { "$ref": "#/$defs/choice" } }
            },
            "required": ["from", "chosen"],
            "additionalProperties": false
          }
        }
      },
      "not": { "required": ["chosen", "choose"] }
    },
    "choice": {
      "description": "One choice:\n- a reference: relative to the container it's chosen from (`@bases.blast`), as written there if the option is itself a reference (`@basic_moves.use_magic.heal`), or absolute for another playbook (`@the_spellslinger.moves.practitioner`)\n- a plain-string option: as written\n- free text: { ref: \"@textbox\", text }\n- a choice with its own choices: { ref, chosen } / { ref, choose }",
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/reference" },
        { "$ref": "common.schema.json#/$defs/plainText" },
        { "$ref": "#/$defs/textChoice" },
        { "$ref": "#/$defs/refWithChoices" }
      ]
    },
    "textChoice": {
      "type": "object",
      "properties": {
        "ref": { "const": "@textbox" },
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["ref", "text"],
      "additionalProperties": false
    },
    "refWithChoices": {
      "description": "The hunter's side of a playbook object (a grant, an improvement, a pick with its own choices): just its reference when nothing's attached, otherwise { ref, ... }. Improvements:\n- root-relative (`@improvements.basic.weird`)\n- `cost` if it cost more than 1\n- `pending` while being picked",
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/reference" },
        {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/choices" }],
          "properties": {
            "ref": { "$ref": "common.schema.json#/$defs/reference" },
            "cost": { "type": "integer", "minimum": 1 },
            "pending": { "const": true }
          },
          "required": ["ref"],
          "unevaluatedProperties": false
        }
      ]
    },
    "computed": {
      "description": "Derived sheet values, not authoritative. Moves and features are copies of the playbook objects, plus `selected` (picked from their options, written like `chosen`) and `crossed`.",
      "type": "object",
      "properties": {
        "ratings": { "$ref": "common.schema.json#/$defs/ratings" },
        "moves": { "type": "array", "items": { "$ref": "#/$defs/computedItem" } },
        "gear": { "type": "array", "items": { "type": "object" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/computedItem" } }
      },
      "required": ["ratings", "moves", "gear", "features"],
      "additionalProperties": false
    },
    "computedItem": {
      "type": "object",
      "properties": {
        "selected": { "type": "array", "items": { "$ref": "#/$defs/choice" } },
        "crossed": { "type": "array", "items": { "$ref": "#/$defs/choice" } }
      }
    }
  }
}
