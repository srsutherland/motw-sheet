{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "basic-moves.schema.json",
  "title": "Basic moves",
  "$comment": "PRELIMINARY. Describes the format as the app uses it today; it isn't a spec to design against, and it changes whenever development needs it. Background and decisions: docs/Schema Notes.md.",
  "description": "The moves every hunter has.",
  "type": "object",
  "properties": {
    "$schema": { "description": "JSON Schema URI", "type": "string" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "updated": { "description": "Date last changed", "$ref": "common.schema.json#/$defs/dateString" },
    "id": { "const": "basic_moves" },
    "type": { "const": "basic_moves" },
    "name": { "type": "string" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "type": { "description": "Object type hint", "const": "basic_move" },
          "name": { "description": "Display name", "type": "string" },
          "rating": { "description": "Rating rolled (none for Big Magic)", "$ref": "common.schema.json#/$defs/rating" },
          "description": { "description": "The display text from the reference sheet", "$ref": "common.schema.json#/$defs/paragraphs" },
          "details": { "$ref": "common.schema.json#/$defs/details" },
          "advanced": {
            "description": "Advanced result (12+), for a move marked advanced",
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/paragraphs" },
              {
                "type": "object",
                "properties": {
                  "description": { "$ref": "common.schema.json#/$defs/paragraphs" },
                  "details": { "$ref": "common.schema.json#/$defs/details" }
                },
                "required": ["description", "details"],
                "additionalProperties": false
              }
            ]
          },
          "options": {
            "description": "List of options to choose from",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/id" },
                "description": { "$ref": "common.schema.json#/$defs/markdown" }
              },
              "required": ["id", "description"],
              "additionalProperties": false
            }
          }
        },
        "required": ["type", "name", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "updated", "id", "type", "name", "options"],
  "additionalProperties": false
}
